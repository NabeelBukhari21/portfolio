# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables (add the same names).
# NEVER commit .env.local — it's already in .gitignore.

# --- Ask Nabeel.AI (get a key at https://aistudio.google.com) ---
GEMINI_API_KEY=
# Optional: override the model if Google retires the default
GEMINI_MODEL=gemini-2.5-flash

# --- Encrypted vault in the Contact section ---
# The access key recruiters type in. Put it on your resume, e.g. "Portfolio key: neon-ronin"
CONTACT_PASSWORD=
# Shown only after the correct key is entered. Leave blank to hide.
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_NOTE=

# --- The Vault (password-protected documents) ---
# Access key for the vault. Falls back to CONTACT_PASSWORD if left blank.
VAULT_PASSWORD=
# 32-byte base64 key that encrypts the files in /vault. Create it with: npm run vault:pack -- --init
# Use the SAME value on Vercel. Losing it means the encrypted files can't be opened.
VAULT_KEY=


# --- Live GitHub chart (Channel section) — optional but recommended ---
# A fine-grained token with NO extra permissions (public data only). Without it the chart still
# works from public pages, but the commit feed can hit GitHub's anonymous rate limit.
GITHUB_TOKEN=

# --- Vault "request a key" notifications — set at least one ---
# Email (resend.com, free tier). Sign up with the inbox that should receive requests.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Instant phone push: install the free "ntfy" app, subscribe to a long random topic name, put it here.
NTFY_TOPIC=
# Or a Discord channel webhook
DISCORD_WEBHOOK_URL=
